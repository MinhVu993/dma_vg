            <v-icon left color="white">mdi-text-box</v-icon>
            {{ $t('Reason Details') }}
            <v-spacer></v-spacer>
            <v-btn icon dark @click="reasonTextDialog = false">
                <v-icon>mdi-close</v-icon>
            </v-btn>
        </v-card-title>
        <v-card-text class="pt-4">
            {{ selectedReasonText || $t('No reason available') }}
        </v-card-text>
    </v-card>
